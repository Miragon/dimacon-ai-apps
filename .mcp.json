{
  "mcpServers": {
    "dimacon-planung": {
      "command": "npx",
      "args": ["tsx", "--tsconfig", "tsconfig.mcp.json", "src/mcp/server.ts"]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
